// RUN: cir-opt %s -cir-call-to-skeleton -split-input-file | FileCheck %s

// The manual path: calls to skeleton helper functions are recognized through
// the "skeleton.op" / "skeleton.pure" annotations on their declarations and
// lowered to skeleton ops. Return-value style (2026-09-02 decision): every
// data operand of the helper call is an input; the output is a fresh
// tensor.empty (the `outs`/destination) and the skeleton op result is
// returned from the rewritten function.
//
// These cases use declaration-only pure functions. The translation of pure
// functions that carry a body (the CIR-body → arith-body lowering) lives in
// CirFuncToArith and is tested separately in cir-func-to-arith.cir.

// Test 1: a map call (two inputs); output returned as a new tensor.
module {
  cir.func private @my_add(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_map(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.op", ["map"]>]
  cir.func @compute(%a: !cir.ptr<!cir.float>, %b: !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.region", ["CPU"]>] {
    %fn = cir.get_global @my_add : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    %ret = cir.call @skeleton_map(%fn, %a, %b) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float>
    cir.return %ret : !cir.ptr<!cir.float>
  }
}

// CHECK-LABEL: func.func private @my_add(f32, f32) -> f32
// CHECK-LABEL: func.func @compute
// CHECK-SAME: (%[[A:.*]]: memref<?xf32>, %[[B:.*]]: memref<?xf32>) -> tensor<?xf32>
// CHECK: bufferization.to_tensor
// CHECK: tensor.dim
// CHECK: tensor.empty
// CHECK: skeleton.map
// CHECK-SAME: pure_fn = @my_add
// CHECK: return
// CHECK-NOT: bufferization.materialize_in_destination

// -----

// Test 2: a reduce call (one input); output is a returned rank-0 tensor.
module {
  cir.func private @my_sum(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_reduce(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>) -> !cir.float [#cir.annotation<"skeleton.op", ["reduce"]>]
  cir.func @sum(%a: !cir.ptr<!cir.float>) -> !cir.float {
    %fn = cir.get_global @my_sum : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    %ret = cir.call @skeleton_reduce(%fn, %a) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>) -> !cir.float
    cir.return %ret : !cir.float
  }
}

// CHECK-LABEL: func.func private @my_sum(f32, f32) -> f32
// CHECK-LABEL: func.func @sum
// CHECK-SAME: (%[[A:.*]]: memref<?xf32>) -> tensor<f32>
// CHECK: bufferization.to_tensor
// CHECK: tensor.empty
// CHECK: skeleton.reduce
// CHECK-SAME: pure_fn = @my_sum
// CHECK: return
// CHECK-NOT: bufferization.materialize_in_destination

// -----

// Test 3: an integer map call. Exercises the cir::IntType → IntegerType
// mapping in CirScalarTypeConverter: an i32 pure function used to be rejected
// as "unsupported" because the old hand-written converter only matched MLIR's
// IntegerType, which a !cir.int is not.
module {
  cir.func private @my_add_int(!cir.int<s, 32>, !cir.int<s, 32>) -> !cir.int<s, 32> [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_map(!cir.ptr<!cir.func<(!cir.int<s, 32>, !cir.int<s, 32>) -> !cir.int<s, 32>>>, !cir.ptr<!cir.int<s, 32>>, !cir.ptr<!cir.int<s, 32>>) -> !cir.ptr<!cir.int<s, 32>> [#cir.annotation<"skeleton.op", ["map"]>]
  cir.func @compute_int(%a: !cir.ptr<!cir.int<s, 32>>, %b: !cir.ptr<!cir.int<s, 32>>) -> !cir.ptr<!cir.int<s, 32>> [#cir.annotation<"skeleton.region", ["CPU"]>] {
    %fn = cir.get_global @my_add_int : !cir.ptr<!cir.func<(!cir.int<s, 32>, !cir.int<s, 32>) -> !cir.int<s, 32>>>
    %ret = cir.call @skeleton_map(%fn, %a, %b) : (!cir.ptr<!cir.func<(!cir.int<s, 32>, !cir.int<s, 32>) -> !cir.int<s, 32>>>, !cir.ptr<!cir.int<s, 32>>, !cir.ptr<!cir.int<s, 32>>) -> !cir.ptr<!cir.int<s, 32>>
    cir.return %ret : !cir.ptr<!cir.int<s, 32>>
  }
}

// CHECK-LABEL: func.func private @my_add_int(i32, i32) -> i32
// CHECK-LABEL: func.func @compute_int
// CHECK-SAME: (%[[A:.*]]: memref<?xi32>, %[[B:.*]]: memref<?xi32>) -> tensor<?xi32>
// CHECK: bufferization.to_tensor
// CHECK: tensor.empty
// CHECK: skeleton.map
// CHECK-SAME: pure_fn = @my_add_int
// CHECK: return
// CHECK-NOT: bufferization.materialize_in_destination

// -----

// Test 4: the pure function address is forwarded through a stack local
// (written with a cir.store, read back with a cir.load) instead of being
// passed to the skeleton call directly as a cir.get_global result. The pass
// must follow the load chain back to the stored global address.
module {
  cir.func private @my_mul(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_map(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.op", ["map"]>]
  cir.func @compute(%a: !cir.ptr<!cir.float>, %b: !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.region", ["CPU"]>] {
    %slot = cir.alloca "fn" align(8) : !cir.ptr<!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>>
    %fn = cir.get_global @my_mul : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    cir.store %fn, %slot : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>>
    %fn_loaded = cir.load %slot : !cir.ptr<!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>>, !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    %ret = cir.call @skeleton_map(%fn_loaded, %a, %b) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float>
    cir.return %ret : !cir.ptr<!cir.float>
  }
}

// CHECK-LABEL: func.func private @my_mul(f32, f32) -> f32
// CHECK-LABEL: func.func @compute
// CHECK: bufferization.to_tensor
// CHECK: tensor.empty
// CHECK: skeleton.map
// CHECK-SAME: pure_fn = @my_mul
// CHECK: return

// -----

// Test 5: module-level CIR codegen attributes (cir.*, and the dlti spec that
// mentions !cir.ptr) are dropped from the rewritten module. They name the CIR
// dialect, which mlir-opt (the next tool in the pipeline) does not register,
// so keeping them would make the lowered module unparsable downstream.
module attributes {cir.default_tls_model = #cir.tls_model<tls_dyn>, cir.triple = "x86_64-unknown-linux-gnu"} {
  cir.func private @my_add(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_map(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.op", ["map"]>]
  cir.func @compute(%a: !cir.ptr<!cir.float>, %b: !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.region", ["CPU"]>] {
    %fn = cir.get_global @my_add : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    %ret = cir.call @skeleton_map(%fn, %a, %b) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float>
    cir.return %ret : !cir.ptr<!cir.float>
  }
}

// CHECK-NOT: cir.
// CHECK-NOT: dlti.
// CHECK-LABEL: func.func @compute
// CHECK: skeleton.map

// -----

// Test 6: a GPU-preference host. The preference survives into the skeleton op
// as #skeleton.preference<"GPU"> (the enum is translated back to a string in
// the lowering).
module {
  cir.func private @gpu_add(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_gpu_map(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.op", ["map"]>]
  cir.func @gpu_compute(%a: !cir.ptr<!cir.float>, %b: !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.region", ["GPU"]>] {
    %fn = cir.get_global @gpu_add : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    %ret = cir.call @skeleton_gpu_map(%fn, %a, %b) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float>
    cir.return %ret : !cir.ptr<!cir.float>
  }
}

// CHECK-LABEL: func.func private @gpu_add(f32, f32) -> f32
// CHECK-LABEL: func.func @gpu_compute
// CHECK: skeleton.map
// CHECK-SAME: preference = <"GPU">
// CHECK-SAME: pure_fn = @gpu_add

// -----

// Test 7: a map call whose data operands are passed in a different order than
// the host declares its parameters (%b before %a). The map's inputs must
// follow the call's argument order, not the host's parameter order; otherwise a
// non-commutative pure function would silently receive its operands swapped.
module {
  cir.func private @my_sub(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_map(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.op", ["map"]>]
  cir.func @swap(%a: !cir.ptr<!cir.float>, %b: !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float> [#cir.annotation<"skeleton.region", ["CPU"]>] {
    %fn = cir.get_global @my_sub : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    %ret = cir.call @skeleton_map(%fn, %b, %a) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> !cir.ptr<!cir.float>
    cir.return %ret : !cir.ptr<!cir.float>
  }
}

// CHECK-LABEL: func.func private @my_sub(f32, f32) -> f32
// CHECK-LABEL: func.func @swap
// CHECK-SAME: (%[[A:.*]]: memref<?xf32>, %[[B:.*]]: memref<?xf32>) -> tensor<?xf32>
// The call passes %b (the second parameter, %[[B]]) before %a, so %[[B]] must
// be turned into a tensor and fed to the map first.
// CHECK: %[[T_B:.*]] = bufferization.to_tensor %[[B]]
// CHECK: %[[T_A:.*]] = bufferization.to_tensor %[[A]]
// CHECK: skeleton.map{{.*}}pure_fn = @my_sub{{.*}}ins(%[[T_B]], %[[T_A]]
// CHECK: return


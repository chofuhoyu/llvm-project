// RUN: cir-opt %s -cir-call-to-skeleton -split-input-file -verify-diagnostics | FileCheck %s

// The manual path: calls to skeleton helper functions are recognized through
// the "skeleton.op" / "skeleton.pure" annotations on their declarations and
// lowered to skeleton ops. This first step still uses destination-passing
// (the last pointer argument is the output buffer); return-value style is a
// follow-up.

// Test 1: a map call (two inputs + one output buffer).
module {
  cir.func private @my_add(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_map(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) [#cir.annotation<"skeleton.op", ["map"]>]
  cir.func @compute(%a: !cir.ptr<!cir.float>, %b: !cir.ptr<!cir.float>, %out: !cir.ptr<!cir.float>) [#cir.annotation<"skeleton.region", ["CPU"]>] {
    %fn = cir.get_global @my_add : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    cir.call @skeleton_map(%fn, %a, %b, %out) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> ()
    cir.return
  }
}

// CHECK-LABEL: func.func private @my_add(f32, f32) -> f32
// CHECK-LABEL: func.func @compute
// CHECK-SAME: memref<?xf32>
// CHECK: bufferization.to_tensor
// CHECK: skeleton.map
// CHECK-SAME: pure_fn = @my_add
// CHECK: bufferization.materialize_in_destination

// -----

// Test 2: a reduce call (one input + one scalar output buffer).
module {
  cir.func private @my_sum(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  cir.func private @skeleton_reduce(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) [#cir.annotation<"skeleton.op", ["reduce"]>]
  cir.func @sum(%a: !cir.ptr<!cir.float>, %out: !cir.ptr<!cir.float>) {
    %fn = cir.get_global @my_sum : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    cir.call @skeleton_reduce(%fn, %a, %out) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> ()
    cir.return
  }
}

// CHECK-LABEL: func.func private @my_sum(f32, f32) -> f32
// CHECK-LABEL: func.func @sum
// CHECK-SAME: memref<f32>
// CHECK: skeleton.reduce
// CHECK-SAME: pure_fn = @my_sum
// CHECK: bufferization.materialize_in_destination

// -----

// Test 3: a pure function that carries a body is rejected — translating a CIR
// body to func.func is not implemented yet. Declaration-only pure functions
// keep working (see the TODO above convertPureFunctionsToFunc).
module {
  cir.func private @my_add(!cir.float, !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">]
  // expected-error@+1 {{translating its CIR body to func.func is not implemented}}
  cir.func @my_add_impl(%a: !cir.float, %b: !cir.float) -> !cir.float [#cir.annotation<"skeleton.pure">] {
    %0 = cir.fadd %a, %b : !cir.float
    cir.return %0 : !cir.float
  }
  cir.func private @skeleton_map(!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) [#cir.annotation<"skeleton.op", ["map"]>]
  cir.func @compute(%a: !cir.ptr<!cir.float>, %b: !cir.ptr<!cir.float>, %out: !cir.ptr<!cir.float>) {
    %fn = cir.get_global @my_add : !cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>
    cir.call @skeleton_map(%fn, %a, %b, %out) : (!cir.ptr<!cir.func<(!cir.float, !cir.float) -> !cir.float>>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>, !cir.ptr<!cir.float>) -> ()
    cir.return
  }
}

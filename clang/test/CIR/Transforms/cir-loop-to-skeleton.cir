// Semi-automatic map path: an annotated element-wise loop is rewritten into a
// func.func pure leaf (the extracted body's scalar computation, in arith) plus
// a host func.func carrying a skeleton.map.
//
// RUN: cir-opt %s -cir-loop-to-skeleton -split-input-file | FileCheck %s

!s32i = !cir.int<s, 32>
!s64i = !cir.int<s, 64>
module {
  cir.func @annotated_for(%arg0: !s32i, %arg1: !cir.ptr<!cir.float>,
                          %arg2: !cir.ptr<!cir.float>, %arg3: !cir.ptr<!cir.float>) {
    %0 = cir.alloca "N" align(4) init : !cir.ptr<!s32i>
    %1 = cir.alloca "A" align(8) init : !cir.ptr<!cir.ptr<!cir.float>>
    %2 = cir.alloca "B" align(8) init : !cir.ptr<!cir.ptr<!cir.float>>
    %3 = cir.alloca "C" align(8) init : !cir.ptr<!cir.ptr<!cir.float>>
    cir.store %arg0, %0 : !s32i, !cir.ptr<!s32i>
    cir.store %arg1, %1 : !cir.ptr<!cir.float>, !cir.ptr<!cir.ptr<!cir.float>>
    cir.store %arg2, %2 : !cir.ptr<!cir.float>, !cir.ptr<!cir.ptr<!cir.float>>
    cir.store %arg3, %3 : !cir.ptr<!cir.float>, !cir.ptr<!cir.ptr<!cir.float>>
    cir.scope {
      %4 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      %5 = cir.const #cir.int<0> : !s32i
      cir.store align(4) %5, %4 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %6 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
        %7 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %8 = cir.cmp lt %6, %7 : !s32i
        cir.condition(%8)
      } body {
        %6 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
        %7 = cir.cast integral %6 : !s32i -> !s64i
        %8 = cir.load align(8) %1 : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
        %9 = cir.ptr_stride %8, %7 : (!cir.ptr<!cir.float>, !s64i) -> !cir.ptr<!cir.float>
        %10 = cir.load align(4) %9 : !cir.ptr<!cir.float>, !cir.float
        %11 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
        %12 = cir.cast integral %11 : !s32i -> !s64i
        %13 = cir.load align(8) %2 : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
        %14 = cir.ptr_stride %13, %12 : (!cir.ptr<!cir.float>, !s64i) -> !cir.ptr<!cir.float>
        %15 = cir.load align(4) %14 : !cir.ptr<!cir.float>, !cir.float
        %16 = cir.fadd %10, %15 : !cir.float
        %17 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
        %18 = cir.cast integral %17 : !s32i -> !s64i
        %19 = cir.load align(8) %3 : !cir.ptr<!cir.ptr<!cir.float>>, !cir.ptr<!cir.float>
        %20 = cir.ptr_stride %19, %18 : (!cir.ptr<!cir.float>, !s64i) -> !cir.ptr<!cir.float>
        cir.store align(4) %16, %20 : !cir.float, !cir.ptr<!cir.float>
        cir.yield
      } step {
        %6 = cir.load align(4) %4 : !cir.ptr<!s32i>, !s32i
        %7 = cir.inc nsw %6 : !s32i
        cir.store align(4) %7, %4 : !s32i, !cir.ptr<!s32i>
        cir.yield
      } [#cir.annotation<"skeleton.region", ["CPU"]>]
    }
    cir.return
  }
}

// The loop body becomes a private pure function whose parameters are the input
// element types; the host becomes a memref/tensor func.func with a
// skeleton.map in return-value style (no destination-passing materialize).
// CHECK-LABEL: func.func private @__skeleton_pure_0
// CHECK: arith.addf
// CHECK-LABEL: func.func @annotated_for
// CHECK-SAME: ([[A:.*]]: memref<?xf32>, [[B:.*]]: memref<?xf32>) -> tensor<?xf32>
// CHECK: bufferization.to_tensor
// CHECK: tensor.empty
// CHECK: skeleton.map
// CHECK-SAME: pure_fn = @__skeleton_pure_0
// CHECK: return
// CHECK-NOT: bufferization.materialize_in_destination

// -----

// A loop without the skeleton.region annotation is left untouched.
!s32i = !cir.int<s, 32>
module {
  cir.func @untouched() {
    cir.scope {
      %0 = cir.alloca "i" align(4) init : !cir.ptr<!s32i>
      %1 = cir.const #cir.int<0> : !s32i
      cir.store align(4) %1, %0 : !s32i, !cir.ptr<!s32i>
      cir.for : cond {
        %2 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %3 = cir.const #cir.int<10> : !s32i
        %4 = cir.cmp lt %2, %3 : !s32i
        cir.condition(%4)
      } body {
        cir.yield
      } step {
        %2 = cir.load align(4) %0 : !cir.ptr<!s32i>, !s32i
        %3 = cir.inc nsw %2 : !s32i
        cir.store align(4) %3, %0 : !s32i, !cir.ptr<!s32i>
        cir.yield
      }
    }
    cir.return
  }
}
// CHECK-LABEL: cir.func @untouched
// CHECK: cir.for
// CHECK-NOT: skeleton.
// CHECK-NOT: func.func

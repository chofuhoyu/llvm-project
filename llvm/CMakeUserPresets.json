{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug Build",
      "description": "Debug build with assertions enabled",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LLVM_ENABLE_ASSERTIONS": "ON",
        "LLVM_ENABLE_PROJECTS": "clang;mlir",
        "LLVM_USE_SPLIT_DWARF": "ON",
        "LLVM_PARALLEL_LINK_JOBS": "1",
        "LLVM_TARGETS_TO_BUILD": "Native",
        "LLVM_USE_LINKER": "lld",
        "CLANG_ENABLE_CIR": "ON",
        "MLIR_ENABLE_EXECUTION_ENGINE": "ON"
      }
    }
  ]
}
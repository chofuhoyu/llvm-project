// Concatenated (by the test's RUN line) after the C++-compiled operators.
// Top-level ops only; no `module {` wrapper, so the whole stream stays one
// implicit module.
//
// Two inputs of different lengths: the host's bare pointers say nothing about
// how long the arrays are, so nothing about this is wrong until the rewritten
// function looks at the memrefs it was handed. The extent check it carries is
// what notices.
func.func @main() {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %c2 = arith.constant 2 : index
  %c3 = arith.constant 3 : index
  %c4 = arith.constant 4 : index
  %c8 = arith.constant 8 : index
  %a0 = arith.constant 1.0 : f32
  %a1 = arith.constant 2.0 : f32
  %a2 = arith.constant 3.0 : f32
  %a3 = arith.constant 4.0 : f32
  %b0 = arith.constant 5.0 : f32
  %b1 = arith.constant 6.0 : f32
  %b2 = arith.constant 7.0 : f32
  %b3 = arith.constant 8.0 : f32
  %b4 = arith.constant 9.0 : f32
  %A = memref.alloc(%c4) : memref<?xf32>
  %B = memref.alloc(%c8) : memref<?xf32>
  memref.store %a0, %A[%c0] : memref<?xf32>
  memref.store %a1, %A[%c1] : memref<?xf32>
  memref.store %a2, %A[%c2] : memref<?xf32>
  memref.store %a3, %A[%c3] : memref<?xf32>
  memref.store %b0, %B[%c0] : memref<?xf32>
  memref.store %b1, %B[%c1] : memref<?xf32>
  memref.store %b2, %B[%c2] : memref<?xf32>
  memref.store %b3, %B[%c3] : memref<?xf32>
  memref.store %b4, %B[%c4] : memref<?xf32>
  %res = call @vec_add(%A, %B) : (memref<?xf32>, memref<?xf32>) -> tensor<?xf32>
  %unranked = tensor.cast %res : tensor<?xf32> to tensor<*xf32>
  call @printMemrefF32(%unranked) : (tensor<*xf32>) -> ()
  return
}

func.func private @printMemrefF32(%ptr : tensor<*xf32>)

#!/bin/sh
# skeleton++ -- compile a whole C++ program that uses skeleton operators.
#
#   skeleton++ app.cpp -o app          emit an executable artifact
#   skeleton++ app.cpp -o app.mlir --emit-mlir
#                                      stop after lowering, keep the module
#   skeleton++ app.cpp --run           run it through the driver (JIT)
#
# The three steps are the ones the e2e tests drive by hand:
#
#   clang++ -fclangir -emit-cir            C++ -> CIR (the whole program,
#                                          including main and the operators)
#   cir-opt --cir-skeleton-split --cir-to-llvm=allow-mixed-module
#           --cir-strip-cir-attrs
#                                          split the operators out, lower the
#                                          host to LLVM, drop CIR metadata
#   mlir-skeleton-driver ... --emit        compile and link, or run in-process
#
# Tool paths are baked in at build time; the SKELETON_CLANG / SKELETON_CIR_OPT /
# SKELETON_DRIVER / SKELETON_RUNTIME_LIB environment variables override them.

set -eu

CLANG=${SKELETON_CLANG:-@SKELETON_CLANG@}
CIR_OPT=${SKELETON_CIR_OPT:-@SKELETON_CIR_OPT@}
DRIVER=${SKELETON_DRIVER:-@SKELETON_DRIVER@}
RUNTIME_LIB=${SKELETON_RUNTIME_LIB:-@SKELETON_RUNTIME_LIB@}
MLIR_INCLUDE=${SKELETON_MLIR_INCLUDE:-@SKELETON_MLIR_INCLUDE@}

usage() {
  cat <<'EOF'
usage: skeleton++ <input.cpp> [options]

  -o <path>              output path (default: a.out)
  --emit-mlir            write the lowered module instead of an executable
  --run                  run the program through the driver instead of linking
  --keep-cir <path>      keep the CIR module at <path>
  --link-arg=<arg>       extra linker argument for the emitted artifact
  --shared-lib=<path>    extra shared library the driver resolves symbols from
  --driver-arg=<arg>     extra argument for the driver (e.g. --driver-arg=--trace)
  --clang-arg=<arg>      extra argument to the C++ front end
  --clang=<path>         C++ front end to use
  --cir-opt=<path>       cir-opt to use
  --driver=<path>        mlir-skeleton-driver to use
  -h, --help             this message
EOF
}

input=
output=a.out
emit_mlir=0
run=0
keep_cir=
clang_args=
driver_args=
link_args=

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --emit-mlir) emit_mlir=1 ;;
    --run) run=1 ;;
    -o) shift; output=$1 ;;
    -o*) output=${1#-o} ;;
    --keep-cir) shift; keep_cir=$1 ;;
    --link-arg=*) link_args="$link_args $1" ;;
    --shared-lib=*) driver_args="$driver_args --shared-libs=${1#--shared-lib=}" ;;
    --driver-arg=*) driver_args="$driver_args ${1#--driver-arg=}" ;;
    --clang-arg=*) clang_args="$clang_args ${1#--clang-arg=}" ;;
    --clang=*) CLANG=${1#--clang=} ;;
    --cir-opt=*) CIR_OPT=${1#--cir-opt=} ;;
    --driver=*) DRIVER=${1#--driver=} ;;
    -*) clang_args="$clang_args $1" ;;
    *) input=$1 ;;
  esac
  shift
done

if [ -z "$input" ]; then
  echo "skeleton++: no input file" >&2
  usage >&2
  exit 1
fi

work=${TMPDIR:-/tmp}/skeleton-$$-$(basename "$input")
mkdir -p "$work"
trap 'rm -rf "$work"' EXIT

cir="$work/program.cir"
module="$work/program.mlir"

# The front end lowers the whole program, operators included. The header is
# found through the MLIR include directory, which is where SkeletonOps.h lives.
# shellcheck disable=SC2086
"$CLANG" -std=c++20 -fno-exceptions -fno-rtti -fclangir -emit-cir \
  -I "$MLIR_INCLUDE" $clang_args "$input" -o "$cir"

if [ -n "$keep_cir" ]; then
  cp "$cir" "$keep_cir"
fi

# Split the operators out, lower the rest of the program to the LLVM dialect,
# and strip the CIR attributes a non-CIR consumer cannot parse. The operator
# units are `func.func` after the split and are compiled separately, so the
# lowering has to leave them alone (allow-mixed-module) instead of failing on
# the func dialect.
"$CIR_OPT" "$cir" --cir-skeleton-split --cir-to-llvm=allow-mixed-module \
  --cir-strip-cir-attrs -o "$module"

if [ "$emit_mlir" -eq 1 ]; then
  cp "$module" "$output"
  exit 0
fi

if [ "$run" -eq 1 ]; then
  # shellcheck disable=SC2086
  exec "$DRIVER" "$module" -entry main --runtime-lib="$RUNTIME_LIB" $driver_args
fi

# shellcheck disable=SC2086
"$DRIVER" "$module" -entry main --emit "$output" --runtime-lib="$RUNTIME_LIB" \
  $link_args
